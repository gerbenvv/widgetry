{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "declaration": true,
        "emitDeclarationOnly": true,
        "outDir": "dist/types",
        "rootDir": "src",
        "target": "es2022",
        "module": "es2022",
        "moduleResolution": "bundler",
        "lib": ["es2023", "dom", "dom.iterable"],
        "skipLibCheck": true,
        "strict": false
    },
    "include": ["src/**/*.js"],
    "exclude": ["src/**/tests/**"]
}
