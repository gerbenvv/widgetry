{
    "name": "widgetry",
    "version": "1.0.0",
    "description": "A desktop-style (GTK-inspired) widget toolkit for the browser: windows, menus, toolbars, tables, dialogs and more, with a classic Clearlooks look",
    "type": "module",
    "main": "./dist/widgetry.js",
    "module": "./dist/widgetry.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/widgetry.js",
            "default": "./dist/widgetry.js"
        },
        "./widgetry.css": "./dist/widgetry.css",
        "./dist/*": "./dist/*",
        "./src/*.js": {
            "types": "./dist/types/*.d.ts",
            "default": "./src/*.js"
        },
        "./src/*": "./src/*",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src",
        "!src/**/tests",
        "CHANGELOG.md",
        "CITATION.cff"
    ],
    "sideEffects": [
        "*.css",
        "./src/**/*.js",
        "./dist/*.js"
    ],
    "scripts": {
        "build": "node scripts/build.js",
        "types": "node scripts/types.js",
        "test": "npm run test:unit && npm run test:browser",
        "test:unit": "node --test \"src/{core,data,i18n,icons,construction,navigation}/**/tests/*_test.js\"",
        "test:browser": "playwright test",
        "lint": "eslint .",
        "format": "eslint --fix . && prettier --write \"**/*.{css,html,json}\" --log-level warn",
        "serve": "node scripts/serve.js",
        "prepublishOnly": "npm run build && npm test"
    },
    "author": "Gerben van Veenendaal <gerbenvv@gmail.com>",
    "license": "BSD-3-Clause",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gerbenvv/widgetry.git"
    },
    "homepage": "https://github.com/gerbenvv/widgetry#readme",
    "bugs": {
        "url": "https://github.com/gerbenvv/widgetry/issues"
    },
    "keywords": [
        "ui",
        "widgets",
        "toolkit",
        "gtk",
        "desktop",
        "window",
        "menu",
        "table",
        "dialog",
        "clearlooks"
    ],
    "engines": {
        "node": ">=20"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.12.0",
        "prettier": "^3.9.6",
        "typescript": "^7.0.2"
    },
    "prettier": {
        "tabWidth": 4,
        "useTabs": false,
        "singleQuote": true,
        "semi": true,
        "printWidth": 100,
        "trailingComma": "es5"
    }
}
